
@model BookStoreMini.Models.Sach

@{
    ViewBag.Title = "Chi tiết sách";
}

<h2>Chi tiết sách</h2>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3>@Model.TenSach</h3>
    </div>

    <div class="panel-body">
        <p><strong>Mã sách:</strong> @Model.MaSach</p>
        <p><strong>Tác giả:</strong> @Model.TacGia</p>
        <p><strong>Thể loại:</strong> @Model.TheLoai.TenTL</p>
        <p>
            <strong>Giá bán:</strong>
            @Model.GiaBan.ToString("#,##0") đ
        </p>
        <p><strong>Mô tả:</strong> @Model.MoTa</p>

        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <img src="@Url.Content("~/Content/Images/" + Model.HinhAnh)"
                 alt="@Model.TenSach"
                 style="max-width:250px;" />
        }
    </div>
</div>

@Html.ActionLink("Quay lại danh sách", "Index", "Sach")
